{
  "name": "mcq-generator-node",
  "version": "1.0.0",
  "description": "Backend for MCQ Generator using Google Gemini and OpenAI",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "node build-css.js",
    "watch:css": "nodemon --watch public/styles.css --exec \"node build-css.js\"",
    "build": "npm run build:css",
    "test": "jest --verbose --coverage",
    "test:watch": "jest --watch --verbose"
  },
  "dependencies": {
    "@google/generative-ai": "^0.1.3",
    "@tailwindcss/postcss": "^4.2.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "mongoos": "^0.0.1-security",
    "mongoose": "^9.4.1",
    "openai": "^4.20.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "postcss": "^8.5.6",
    "supertest": "^6.3.3",
    "tailwindcss": "^4.1.17"
  }
}
